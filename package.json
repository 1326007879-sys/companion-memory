{
  "name": "dsh-companion-memory-core",
  "version": "0.1.2",
  "description": "Local, host-independent long-term memory core for DeepSeek Harness: plain-text notes, a bounded index, and auditable evidence.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "icon.png"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <0.4.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.2 <0.4.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1326007879-sys/companion-memory.git"
  }
}
